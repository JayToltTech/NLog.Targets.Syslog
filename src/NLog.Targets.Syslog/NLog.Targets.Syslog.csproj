<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NLog.Targets.Syslog</RootNamespace>
    <AssemblyName>NLog.Targets.Syslog</AssemblyName>
    <Description>NLog target sending RFC 5424 syslog over TLS (RFC 5425) with optional mutual TLS and CA pinning</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>
</Project>
